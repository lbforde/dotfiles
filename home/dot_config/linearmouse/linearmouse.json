{
  "$schema" : "https:\/\/schema.linearmouse.app\/0.10.4",
  "schemes" : [
    {
      "buttons" : {
        "clickDebouncing" : {
          "timeout" : 0
        },
        "universalBackForward" : true
      },
      "if" : {
        "device" : {
          "category" : "mouse",
          "productID" : "0xc548",
          "productName" : "USB Receiver",
          "vendorID" : "0x46d"
        }
      },
      "pointer" : {
        "acceleration" : 0.69,
        "disableAcceleration" : true,
        "redirectsToScroll" : false,
        "speed" : "unset"
      },
      "scrolling" : {
        "acceleration" : {
          "vertical" : 1
        },
        "distance" : {
          "vertical" : "auto"
        },
        "modifiers" : {
          "vertical" : {
            "control" : {
              "type" : "zoom"
            },
            "option" : {
              "type" : "preventDefault"
            }
          }
        },
        "reverse" : {
          "vertical" : true
        },
        "speed" : {
          "vertical" : 0
        }
      }
    }
  ]
}