# .chezmoiignore.tmpl
# Interpreted as a Go template — chezmoi applies this on every machine
# and skips anything listed here. Use ne/eq against .chezmoi.os to route
# platform-specific files.

# ─── Platform routing ─────────────────────────────────────────────────────────
# Windows-only files — ignore on Linux/macOS
{{- if ne .chezmoi.os "windows" }}
Documents/PowerShell
.chezmoiscripts/*.ps1
AppData/
AppData/**
{{- end }}

# Linux/macOS-only files - ignore on Windows
{{- if eq .chezmoi.os "windows" }}
.zprofile
.zshenv
.zshrc
.chezmoiscripts/*.sh
.config/tmux
.config/tmux/**
.local/
.local/**
.local/bin/
.local/bin/**
.local/bin/tmux-session
.local/bin/ghostty-tmux-session
{{- end }}

# macOS-only files - ignore on Windows/Linux
{{- if ne .chezmoi.os "darwin" }}
Library/
Library/**
Library/Application Support/Code/User/
Library/Application Support/Code/User/**
.config/ghostty
.config/ghostty/**
.config/linearmouse
.config/linearmouse/**
.config/sketchybar
.config/sketchybar/**
.config/aerospace
.config/aerospace/**
Library/Application Support/Leader Key/
Library/Application Support/Leader Key/**
.local/bin/ghostty-tmux-session
.local/bin/ghostty-tmux-cmd
{{- end }}

# Never manage local chezmoi runtime config from source state.
.config/chezmoi/chezmoi.toml
.config/chezmoi/chezmoi.toml.*.bak
.local/share/chezmoi
.local/share/chezmoi.backup-*

# ─── OS cruft ─────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Sensitive files — manage via gopass/Doppler, never via chezmoi ───────────
*.key
*.pem
*.p12
id_rsa
id_ed25519

# ─── Build / cache dirs ───────────────────────────────────────────────────────
node_modules/
.cache/
__pycache__/
*.pyc
dist/
build/

# ─── IDE workspace files ──────────────────────────────────────────────────────
.idea/
