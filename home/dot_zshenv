skip_global_compinit=1

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

typeset -U path PATH
path=("$HOME/.local/bin" "$HOME/bin" "$path[@]")

if [[ -n "${WSL_DISTRO_NAME:-}" ]] && command -v wslvar >/dev/null 2>&1 && command -v wslpath >/dev/null 2>&1; then
  localappdata="$(wslvar LOCALAPPDATA 2>/dev/null)"
  if [[ -n "$localappdata" ]]; then
    vscode_bin="$(wslpath -u "$localappdata")/Programs/Microsoft VS Code/bin"
    [[ -d "$vscode_bin" ]] && path=("$vscode_bin" "$path[@]")
    unset vscode_bin
  fi
  unset localappdata
fi

export PATH
export PROJECTS="${PROJECTS:-$HOME/projects}"

if [[ -z "${EDITOR:-}" ]]; then
  if command -v code >/dev/null 2>&1; then
    export EDITOR="code --wait"
  elif command -v codium >/dev/null 2>&1; then
    export EDITOR="codium --wait"
  elif command -v nvim >/dev/null 2>&1; then
    export EDITOR="nvim"
  elif command -v vim >/dev/null 2>&1; then
    export EDITOR="vim"
  else
    export EDITOR="vi"
  fi
fi

export VISUAL="${VISUAL:-$EDITOR}"
