#!/bin/zsh
set -euo pipefail

shell_quote() {
  local value="$1"

  if [[ "$value" =~ '^[A-Za-z0-9_./:@%#{}+,-=]+$' ]]; then
    print -r -- "$value"
    return
  fi

  value=${value//\'/\'\\\'\'}
  print -r -- "'$value'"
}

session_name="$(/usr/bin/osascript <<'APPLESCRIPT'
tell application "Ghostty"
  if (count of windows) is 0 then error "Ghostty has no open windows."
  activate
end tell

try
  set sessionPrompt to display dialog "Attach or create tmux session:" default answer "" buttons {"Cancel", "OK"} default button "OK"
  return text returned of sessionPrompt
on error number -128
  return ""
end try
APPLESCRIPT
)"

[[ -n "$session_name" ]] || exit 0

latest_client_tty=""
typeset -a client_rows
client_rows=("${(@f)$(tmux list-clients -F '#{client_activity}	#{client_tty}' 2>/dev/null)}")

if (( ${#client_rows[@]} > 0 )); then
  integer best_activity=-1
  typeset row activity client_tty

  for row in "${client_rows[@]}"; do
    [[ -n "$row" ]] || continue

    activity="${row%%$'\t'*}"
    client_tty="${row#*$'\t'}"

    if (( activity > best_activity )); then
      best_activity="$activity"
      latest_client_tty="$client_tty"
    fi
  done
fi

if [[ -n "$latest_client_tty" ]]; then
  tmux has-session -t "$session_name" 2>/dev/null || tmux new-session -d -s "$session_name"
  tmux switch-client -c "$latest_client_tty" -t "$session_name"
  exit 0
fi

quoted_session="$(shell_quote "$session_name")"
shell_command=" ~/.local/bin/tmux-session $quoted_session"

/usr/bin/osascript - "$shell_command" <<'APPLESCRIPT'
on run argv
  set shellCommand to item 1 of argv

  tell application "Ghostty"
    if (count of windows) is 0 then error "Ghostty has no open windows."
    activate
  end tell

  delay 0.2

  tell application "System Events"
    keystroke shellCommand
    key code 36
  end tell
end run
APPLESCRIPT
